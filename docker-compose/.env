APPLICATION_VERSION=

# Redis starting defaults, not workload sizing. Leave headroom for AOF rewrites.
REDIS_MAXMEMORY=512mb
REDIS_MEMORY_LIMIT=2g
REDIS_MEMORY_REQUEST=512m
REDIS_CPU_LIMIT=1
REDIS_CPU_REQUEST=0.1
REDIS_START_PERIOD=30m
LICENSE_KEY=
SECRET_KEY=

DB_USER=syntho
DB_PASSWORD=
USER_EMAIL=
USER_PASSWORD=

SECURE_COOKIES="False"
FRONTEND_PROTOCOL=http
FRONTEND_DOMAIN=localhost
FRONTEND_PORT=3000
FRONTEND_URL="${FRONTEND_PROTOCOL}://${FRONTEND_DOMAIN}:${FRONTEND_PORT}"
EXTRA_ALLOWED_HOSTS="${FRONTEND_DOMAIN} backend"
DJANGO_PRODUCTION=True
